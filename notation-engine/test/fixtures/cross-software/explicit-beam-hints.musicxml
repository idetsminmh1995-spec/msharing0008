<?xml version="1.0" encoding="UTF-8"?>
<!-- §10.8 divergence: explicit <beam> elements. Some programs write
     these to record their own exact beaming decisions; this engine
     currently always computes its own grouping (Phase 23) rather than
     reading them (a stated Tier 2/3 gap, Doc/phase-35). This fixture
     confirms an explicit <beam> element is silently and safely ignored
     — not crashed on — while the note data itself still parses and
     renders correctly. -->
<score-partwise version="3.1">
  <part-list><score-part id="P1"><part-name>Piano</part-name></score-part></part-list>
  <part id="P1">
    <measure number="1">
      <attributes>
        <divisions>2</divisions>
        <time><beats>4</beats><beat-type>4</beat-type></time>
        <clef><sign>G</sign><line>2</line></clef>
      </attributes>
      <note>
        <pitch><step>C</step><octave>5</octave></pitch>
        <duration>1</duration><voice>1</voice><type>eighth</type>
        <beam number="1">begin</beam>
      </note>
      <note>
        <pitch><step>D</step><octave>5</octave></pitch>
        <duration>1</duration><voice>1</voice><type>eighth</type>
        <beam number="1">end</beam>
      </note>
      <note><rest/><duration>6</duration><voice>1</voice><type>quarter</type></note>
    </measure>
  </part>
</score-partwise>
