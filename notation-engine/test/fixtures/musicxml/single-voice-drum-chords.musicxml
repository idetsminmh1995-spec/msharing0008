<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chord stem direction on a drum staff (Step 1 of the notation-accuracy work).
  Shaped like a real MuseScore export of a hi-hat + snare groove:
    m1  ONE voice, hi-hat+snare chords, every note carries <stem>up</stem>
        (MuseScore's own choice - the case the engine used to draw DOWN).
    m2  ONE voice, kick+snare chords carrying <stem>down</stem>
        (the automatic direction for these would be up, so the file must win).
    m3  ONE voice, hi-hat+snare chords with NO <stem> element
        (automatic direction - unchanged behaviour).
    m4  TWO voices: voice 1 hi-hat+snare chords <stem>up</stem>, voice 2 kick
        <stem>down</stem> (the per-voice hands-up / feet-down split).
-->
<score-partwise version="4.0">
  <part-list>
    <score-part id="P1">
      <part-name>Drum Kit</part-name>
      <score-instrument id="P1-KICK"><instrument-name>Bass Drum 1</instrument-name></score-instrument>
      <score-instrument id="P1-SNARE"><instrument-name>Acoustic Snare</instrument-name></score-instrument>
      <score-instrument id="P1-HH"><instrument-name>Closed Hi-Hat</instrument-name></score-instrument>
      <midi-instrument id="P1-KICK"><midi-channel>10</midi-channel><midi-unpitched>37</midi-unpitched></midi-instrument>
