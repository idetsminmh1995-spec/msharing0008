node_modules/
dist/
build/

# EXCEPTION: the Notation Engine's built bundle and its SMuFL font must be
# committed -- the web app is served as static files from GitHub Pages, which
# has no build step, so the browser can only load them if they're in the repo.
#
# ONLY those two things. The sourcemap (2x the bundle's size) and the
# generated .d.ts files are build output the browser never requests; both are
# regenerated by `npm run build` / `npm run declarations` on demand, and
# committing them would add churn to every source change for no benefit.
!notation-engine/dist/
!notation-engine/dist/notation-engine.js
!notation-engine/dist/fonts/
!notation-engine/dist/fonts/**
notation-engine/dist/*.map
notation-engine/dist/**/*.d.ts
notation-engine/dist/*.d.ts

# Same exception, same reason, for the sticking engine's bundle: the
# drum page loads it with a <script> tag from a host with no build step.
!Drum/sticking-engine-ts/dist/
!Drum/sticking-engine-ts/dist/sticking-engine.js
Drum/sticking-engine-ts/dist/*.map
Drum/sticking-engine-ts/dist/**/*.d.ts
Drum/sticking-engine-ts/dist/*.d.ts
.env
*.log
.DS_Store
*.mid

# EXCEPTION: the sticking engine's own demo fixture. `*.mid` above is for
# the sample files that pile up while testing; this one is a committed
# 185-byte part of the module, named in its README as the file to run the
# demo against. See Drum/README.md.
!Drum/sticking-engine/test_beat.mid

# The sticking engine's demo writes this next to itself on every run.
Drum/sticking-engine/output_performance.json

# Python bytecode caches. The repo had no Python in it until Drum/, so
# this is the first time it has needed these.
__pycache__/
*.pyc
