node_modules/
# The trailing slash above only matches directories, and
# metronome-engine's is a SYMLINK to the sticking engine's -- the two
# packages pin the same toolchain, so there is no reason to install it
# twice. Without this line git would offer to commit the link.
Engine/metronome-engine/node_modules
dist/
build/

# EXCEPTION: the Notation Engine's built bundle and its SMuFL font must be
# committed -- the web app is served as static files from GitHub Pages, which
# has no build step, so the browser can only load them if they're in the repo.
#
# ONLY those two things. The sourcemap (2x the bundle's size) and the
# generated .d.ts files are build output the browser never requests; both are
# regenerated by `npm run build` / `npm run declarations` on demand, and
# committing them would add churn to every source change for no benefit.
!Engine/notation-engine/dist/
!Engine/notation-engine/dist/notation-engine.js
!Engine/notation-engine/dist/fonts/
!Engine/notation-engine/dist/fonts/**
Engine/notation-engine/dist/*.map
Engine/notation-engine/dist/**/*.d.ts
Engine/notation-engine/dist/*.d.ts

# Same exception, same reason, for the sticking engine's bundle: the
# drum page loads it with a <script> tag from a host with no build step.
!Engine/drum-engine/sticking-engine-ts/dist/
!Engine/drum-engine/sticking-engine-ts/dist/sticking-engine.js
Engine/drum-engine/sticking-engine-ts/dist/*.map

# The Piano, Guitar and Finger Engines' node_modules are the same symlink
# trick as the metronome engine's -- one toolchain, installed once.
Engine/piano-engine/node_modules
Engine/guitar-engine/node_modules
Engine/finger-engine/node_modules

# Same for the Metronome Design Engine: the drum page loads its bundle
# from website/assets, and the Metronome page loads it from there too,
# so the built file has to be in the repo. Sourcemap and .d.ts do not.
!Engine/metronome-engine/dist/
!Engine/metronome-engine/dist/metronome-engine.js
Engine/metronome-engine/dist/*.map
Engine/metronome-engine/dist/**/*.d.ts
Engine/metronome-engine/dist/*.d.ts

# And the Piano Engine, which the Piano page loads the same way.
!Engine/piano-engine/dist/
!Engine/piano-engine/dist/piano-engine.js
Engine/piano-engine/dist/*.map
Engine/piano-engine/dist/**/*.d.ts
Engine/piano-engine/dist/*.d.ts

# And the Guitar Engine, for the Guitar page.
!Engine/guitar-engine/dist/
!Engine/guitar-engine/dist/guitar-engine.js
Engine/guitar-engine/dist/*.map
Engine/guitar-engine/dist/**/*.d.ts
Engine/guitar-engine/dist/*.d.ts

# And the Finger Engine. Nothing loads it from the web yet -- Phase 1 wires
# it into the Guitar page -- but its tests run against the BUILT bundle, so
# committing it keeps a checkout testable without a build step, the same way
# every other engine here works.
!Engine/finger-engine/dist/
!Engine/finger-engine/dist/finger-engine.js
Engine/finger-engine/dist/*.map
Engine/finger-engine/dist/**/*.d.ts
Engine/finger-engine/dist/*.d.ts
Engine/drum-engine/sticking-engine-ts/dist/**/*.d.ts
Engine/drum-engine/sticking-engine-ts/dist/*.d.ts
.env
*.log
.DS_Store
*.mid

# EXCEPTION: the sticking engine's own demo fixture. `*.mid` above is for
# the sample files that pile up while testing; this one is a committed
# 185-byte part of the module, named in its README as the file to run the
# demo against. See Engine/drum-engine/README.md.
#
# Same for the Finger Engine's MIDI fixture: F-13 is the plan's own test
# that a MIDI file, which carries no string, fret or finger at all, comes
# out fingered exactly like the MusicXML version of the same scale. It is
# 125 bytes and the test cannot run without it.
!Engine/drum-engine/sticking-engine/test_beat.mid
!Engine/finger-engine/test/fixtures/*.mid

# The sticking engine's demo writes this next to itself on every run.
Engine/drum-engine/sticking-engine/output_performance.json

# Python bytecode caches. The repo had no Python in it until Engine/drum-engine/, so
# this is the first time it has needed these.
__pycache__/
*.pyc
